# Optional public Sepolia RPC endpoint for the browser-only verifier.
# If omitted, the app falls back to https://ethereum-sepolia-rpc.publicnode.com
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional backend port and comma-separated browser origins for local API runs.
PORT=8000
INTENTGUARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
